# Dependencies
node_modules/

# Generated bundle (built via `npm run build`)
public/dist/

# Cached thumbnails (large, fetched at runtime)
public/thumbs/
public/exports/

# ...but the game icons are small, hand-curated art that cannot be regenerated
# by fetching, so they are tracked. Only this subdirectory is un-ignored.
!public/thumbs/_game/
!public/thumbs/_game/**

# Python bytecode
__pycache__/
*.py[cod]

# Logs / temp
*.log
*.tmp
.DS_Store

# Extracted game assets (assets/<game>/<model>/{skel,atlas,png,moc3,...}).
#
# These are EXTRACTION OUTPUT, not source: they are regenerated by the scripts
# in tools/ (and, for DotAbyss/Live2D, by /root/batch_l2d.py +
# /root/build_motions.py) from the game's own bundles. They are large
# (dotabyss-l2d alone is ~1.2 GB across 193 models) and binary, which makes
# the repo slow to clone and useless to diff.
#
# Re-extract with the matching script in tools/ instead of committing these.
assets/*
!assets/.gitkeep

# ...but keep the three built-in demo models (raptor, spineboy, coin). They
# are small (~1.3 MB total), referenced by the README as a smoke test, and
# are the only way to try the viewer without extracting a game first.
!assets/raptor/**
!assets/spineboy/**
!assets/coin/**

# NOTE: assets/stellaraffinity (208 MB) was committed before this rule
# existed and has since been untracked with `git rm --cached`. It stays in
# history; a fresh clone will no longer carry it.

# Scratch copy of one Live2D model used while getting the standalone smoke
# test to render. It is a duplicate of assets/dotabyss-l2d/l2d_10010100012
# (which is itself extraction output), so it does not belong in git.
public/l2d/

# Dead end from the first Live2D spike: an attempt to gate the Cubism core
# load behind a module check. Superseded by loading the core via a plain
# <script> tag in index.html; nothing imports it.
src/l2d-core-gate.js

# Per-deployment runtime state written by PUT /api/favorites. It is the
# server-side mirror of whatever the local browser starred, so committing it
# would push one person's list onto everyone else.
data/favorites.json

# Scan cache written by the server (data/models-cache.json). It is regenerated
# whenever assets/ changes, and it is specific to one machine's asset tree.
data/models-cache.json
data/models-cache.json.tmp

# Pelacak model "baru" (badge NEW): state runtime per mesin, bukan sumber.
data/new-models.json
data/new-models.json.tmp

# Cap versi + daftar bundle updater (diperbarui oleh --apply). Menyimpan
# ~470 nama bundle spesifik mesin, jadi tidak perlu ikut ke repo.
data/*-state.json
data/*-state.json.tmp

# Lost Sword video manifest (regenerated by the extractor).
data/lostsword-videos.json

# XAPK/bundle yang diunduh updater (2.6 GB utk Lost Sword) — cache lokal.
cache/


# Hasil konversi .skel -> JSON (dulu ~5.5 GB). Dihasilkan ulang oleh
# tools/convert-spine2.py bila masih diperlukan; tidak perlu ikut ke repo.
assets/projectqt21/

# Hasil ekstraksi Star Lust (bundle unduhan + model). Dihasilkan ulang oleh
# tools/extract-starlust.py; tidak perlu ikut ke repo.
assets/starlust/
assets/cherrytale/
